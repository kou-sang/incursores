rules_version = '2';

// Sin reglas, el original permitía que cualquier usuario autenticado (o anónimo, según la config)
// borrara/editara rutinas y registros ajenos, y leyera los emails de todos.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validUsername(name) {
      return name is string && name.size() >= 2 && name.size() <= 24;
    }

    // Privado: email y rutina activa.
    match /users/{uid} {
      allow read, write: if isOwner(uid);
    }

    // Público dentro de la app: nombre visible y sexo (mapa corporal).
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && validUsername(request.resource.data.username)
        && request.resource.data.gender in ['masculino', 'femenino'];
      allow delete: if false;
    }

    match /routines/{routineId} {
      allow read: if signedIn(); // Necesario para importar rutinas compartidas por enlace o por el chat del grupo
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.get('copyCount', 0) == 0; // Nadie puede arrancar con copias falsas
      allow update: if signedIn() && (
        // El autor edita su rutina, pero no puede tocar el contador de copias.
        (resource.data.authorId == request.auth.uid
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.get('copyCount', 0) == resource.data.get('copyCount', 0))
        // Otra persona solo puede sumar +1 a copyCount, y una única vez: debe crear su marca en copies/{uid} en el mismo lote.
        || (resource.data.authorId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['copyCount'])
          && request.resource.data.copyCount == resource.data.get('copyCount', 0) + 1
          && !exists(/databases/$(database)/documents/routines/$(routineId)/copies/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/routines/$(routineId)/copies/$(request.auth.uid)))
      );
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      // Marca "esta persona ya copió la rutina" (evita sumar dos veces a la misma persona).
      match /copies/{uid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time
          && get(/databases/$(database)/documents/routines/$(routineId)).data.authorId != uid;
        allow update, delete: if false;
      }
    }

    function validLog(d) {
      return d.userId == request.auth.uid
        && d.exercise is string && d.exercise.size() > 0 && d.exercise.size() <= 60
        && d.sets is int && d.sets >= 1 && d.sets <= 30
        && (d.reps == null || (d.reps is int && d.reps >= 1 && d.reps <= 100))
        && (d.weight == null || (d.weight is number && d.weight >= 0 && d.weight <= 1000))
        && d.performedAt is timestamp
        && d.performedAt < request.time + duration.value(10, 'm'); // Sin fechas futuras
    }

    // Inmutables: corregir = borrar y volver a registrar (historial auditable para el ranking).
    match /workoutLogs/{logId} {
      allow read: if signedIn();
      allow create: if signedIn() && validLog(request.resource.data);
      allow update: if false;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /personalBests/{uid} {
      allow read: if signedIn();
      allow write: if isOwner(uid);
    }

    // ───────── Grupos ─────────
    function validGroupFields(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 40
        && (!('description' in d) || (d.description is string && d.description.size() <= 160))
        && d.memberIds is list && d.memberIds.size() <= 30
        && d.ownerId in d.memberIds
        && d.inviteCode is string && d.inviteCode.size() == 8;
    }

    function addedMembers() {
      return request.resource.data.memberIds.toSet().difference(resource.data.memberIds.toSet());
    }

    function removedMembers() {
      return resource.data.memberIds.toSet().difference(request.resource.data.memberIds.toSet());
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && validGroupFields(request.resource.data);

      // 1) Administrador: edita configuración, quita miembros o transfiere (nunca agrega a terceros sin consentimiento).
      // 2) Unirse: solo se agrega a sí mismo y debe conocer el código vigente (joinCode == inviteCode).
      // 3) Salir: un miembro (no administrador) se quita a sí mismo.
      allow update: if signedIn() && validGroupFields(request.resource.data) && (
        (resource.data.ownerId == request.auth.uid
          && addedMembers().size() == 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'description', 'memberIds', 'ownerId', 'inviteCode', 'updatedAt']))
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'joinCode'])
          && request.resource.data.joinCode == resource.data.inviteCode
          && addedMembers().hasOnly([request.auth.uid])
          && removedMembers().size() == 0)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          && resource.data.ownerId != request.auth.uid
          && removedMembers().hasOnly([request.auth.uid])
          && addedMembers().size() == 0)
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ───────── Chat del grupo ─────────
    // Solo se pueden compartir rutinas (sin texto libre) y máximo 1 mensaje por minuto por persona.
    // El minuto se controla con groups/{groupId}/chatState/{uid}.lastSentAt, que se escribe en el mismo lote que el mensaje.
    function isGroupMember(groupId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function chatStatePath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId)/chatState/$(request.auth.uid);
    }

    function chatCooldownElapsed(groupId) {
      return !exists(chatStatePath(groupId))
        || request.time >= get(chatStatePath(groupId)).data.lastSentAt + duration.value(60, 's');
    }

    function validRoutineMessage(d) {
      return d.keys().hasOnly(['type', 'authorId', 'authorName', 'routineId', 'routineName', 'exerciseCount', 'activeDays', 'createdAt', 'expiresAt'])
        && d.type == 'routine'
        && d.authorId == request.auth.uid
        && d.authorName is string && d.authorName.size() <= 24
        && d.routineId is string && d.routineId.size() > 0 && d.routineId.size() <= 40
        && d.routineName is string && d.routineName.size() >= 1 && d.routineName.size() <= 60
        && d.exerciseCount is int && d.exerciseCount >= 0 && d.exerciseCount <= 500
        && d.activeDays is int && d.activeDays >= 0 && d.activeDays <= 7
        && d.createdAt == request.time
        && d.expiresAt is timestamp;
    }

    match /groups/{groupId}/messages/{messageId} {
      allow read: if isGroupMember(groupId);
      allow create: if isGroupMember(groupId)
        && validRoutineMessage(request.resource.data)
        && chatCooldownElapsed(groupId)
        && getAfter(chatStatePath(groupId)).data.lastSentAt == request.time;
      allow update: if false;
      // Borra el autor o el administrador del grupo (moderación).
      allow delete: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid
      );
    }

    match /groups/{groupId}/chatState/{uid} {
      allow read: if isOwner(uid) && isGroupMember(groupId);
      allow create: if isOwner(uid) && isGroupMember(groupId)
        && request.resource.data.keys().hasOnly(['lastSentAt'])
        && request.resource.data.lastSentAt == request.time;
      allow update: if isOwner(uid) && isGroupMember(groupId)
        && request.resource.data.keys().hasOnly(['lastSentAt'])
        && request.resource.data.lastSentAt == request.time
        && request.time >= resource.data.lastSentAt + duration.value(60, 's');
      // Los miembros no pueden borrarlo (se saltarían el límite); solo el administrador al eliminar el grupo.
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == request.auth.uid;
    }

    // Índice código → grupo. 'get' puntual permitido (hace falta conocer el código); 'list' prohibido (sin enumeración).
    match /groupInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.inviteCode == code;
      allow delete: if signedIn()
        && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId == request.auth.uid;
      allow update: if false;
    }

    // Colección legada: solo lectura hasta completar la migración, luego eliminar.
    match /prs/{docId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
